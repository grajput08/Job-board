# =============================================================================
# Environment variables for the /api/jobs live feed proxy.
# Set these in Vercel: Project → Settings → Environment Variables (then redeploy).
# Never commit real values.
# =============================================================================

# Which provider the proxy uses: "apify" (default) or "jsearch".
JOBS_PROVIDER=apify

# --- Apify (https://apify.com) -----------------------------------------------
# Sign up (free tier ~$5/mo credits), then Settings → Integrations → API token.
APIFY_TOKEN=

# The LinkedIn jobs actor to run. Default: bebity~linkedin-jobs-scraper
# Use the actor's "name~slug" form. Change to whichever actor you subscribe to.
APIFY_ACTOR=bebity~linkedin-jobs-scraper

# OPTIONAL: raw JSON input matching YOUR actor's input schema. When set, it
# fully overrides the default input the proxy builds. Example:
# APIFY_INPUT={"title":"QA","location":"India","rows":50,"publishedAt":"r604800"}
APIFY_INPUT=

# --- JSearch on RapidAPI (recommended free/reliable alternative) -------------
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch  → subscribe (free tier)
# Copy your key from any endpoint's "X-RapidAPI-Key" header.
RAPIDAPI_KEY=
